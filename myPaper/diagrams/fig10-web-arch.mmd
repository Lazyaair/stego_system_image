    style CHAT_S fill:#e8edf2,stroke:#5a5a5a,stroke-width:1.5px
    style CONTACT_S fill:#e8edf2,stroke:#5a5a5a,stroke-width:1.5px
    style WS_S fill:#e8edf2,stroke:#5a5a5a,stroke-width:1.5px
